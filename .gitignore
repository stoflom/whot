__pycache__/
.env
# the two local scratch text files (recovery transcript, the dot-name
# path map) — #339: named entries, not a bare *.txt catch-all that would
# silently ignore any future tracked text file
recover.txt
.pathmap.txt
*.log
*.db
*.db-wal
*.db-shm
*.html
!app/index.html
session*.md
node_modules/

# pi session exports (any project directory)
pi-session-*
**/legacy_*/
!docs/*.html

# Rust build artifacts
target/
.vscode/
!index.html

# Vite build output
dist/

# local scratch area (annotation exports etc. — never commit)
scratch/

# runtime data: faces.db, import copies, import reports — never commit
/data/

# runtime GUI settings (defaults apply when absent)
config/whotrc.json

# machine-specific path map (legacy roots -> local archive; #85)
config/pathmap*.txt
/test/archive-fixture/

# local config backups (machine-specific; *.txt does not catch the .bak suffix)
*.bak-*

# local icon design sources (the asset actually used lives in public/whot.svg)
docs/whot-sc.svg
docs/whot_image*.jpg
docs/whot_image*.svg
