# Sample configuration — copy to `.env` and adjust to your machine.
# `.env` is gitignored; this sanitized sample is safe to commit.
# `${VAR}` references are expanded at load time.

# --- paths relative to the project root ---
DATA_DIR=data
CONFIG_DIR=config
FACES_DB=${DATA_DIR}/faces.db
CONFIG_FILE=${CONFIG_DIR}/whotrc.json
# Python venv providing insightface (relative to project root)
INSIGHTFACE_PATH=../insightface

# --- inputs (all read-only) ---
DEFAULT_IMAGES_DIR=${HOME}/Pictures
ARCHIVE_DIR=/path/to/pictures/archive
DIGIKAM_DB=${HOME}/.config/digikam/digikam4.db
DIGIKAM_RECOGNITION_DB=${HOME}/.config/digikam/recognition.db
LR_CATALOG=/path/to/lightroom/catalog.lrcat
LR_SIDECARS_DIR=/path/to/lightroom/sidecars
